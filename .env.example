# Environment Variables — In My Solitude
# Copy this to .env.local and fill in your actual values

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-side only, NEVER expose

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here

# ─── AI Librarian (Perplexity) ────────────────────────────────
PERPLEXITY_API_KEY=pplx-your-key-here

# ─── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3002   # change to production URL on Vercel
ADMIN_EMAIL=your-admin-email@example.com

# ─── Chat Config (optional tuning) ───────────────────────────
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_MAX_HISTORY_MESSAGES=20
